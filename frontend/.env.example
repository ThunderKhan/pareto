# Copy to frontend/.env.local. This app uses Supabase Auth + owner-scoped Prisma.
# Only NEXT_PUBLIC_* values are browser-visible. Never expose admin/service keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=postgresql://pareto:pareto_local_only@localhost:5432/pareto?schema=public
# Server-only AI provider pairs; select verified model IDs for the account.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# SERVER-ONLY values for the private resume upload API; never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternative if the Supabase project uses legacy service-role tokens.
SUPABASE_SERVICE_ROLE_KEY=

# AI runtime controls (SERVER ONLY). These limits are per-process, not durable quotas.
# AI_ENABLED=false stops Gemini/Groq calls while preserving manual matching.
AI_ENABLED=true
AI_FALLBACK_ENABLED=true
AI_MAX_CONCURRENT_CALLS=4
AI_MAX_CALLS_PER_RECRUITER_HOUR=40
AI_MAX_GLOBAL_CALLS_PER_HOUR=2000

# Pause new uploads, queued retries and the ingestion worker without disabling search.
# Restart running services after changing this setting. In-flight jobs can finish.
RESUME_INGESTION_ENABLED=true

# Optional shared PostgreSQL hourly attempt quota (apply migration before enabling).
AI_DURABLE_QUOTA_ENABLED=false
