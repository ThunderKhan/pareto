# Copy this file to .env. Never commit live keys.
# Local Docker Compose supplies the local database URL to its web service.
DATABASE_URL=postgresql://pareto:pareto_local_only@localhost:5432/pareto?schema=public
DIRECT_DATABASE_URL=
DEMO_OWNER_ID=

# Dedicated Pareto Supabase Auth project only. Leave blank for public-only UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only LLM credentials; only Gemini and Groq are supported.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=

# Hybrid semantic tie-break (automatically active when indexed and Gemini key configured).
PARETO_SEMANTIC_SEARCH=1
# Populate via: pnpm --filter @pareto/backend semantic:index
