# Copy this file to .env. Never commit live keys.
# Local Docker Compose supplies the local database URL to its web service.
DATABASE_URL=postgresql://pareto:pareto_local_only@localhost:5432/pareto?schema=public

# Hosted Supabase project (set during authentication/storage milestone)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only LLM credentials; only Gemini and Groq are supported.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=
