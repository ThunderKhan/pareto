# For Prisma CLI commands executed in backend/
DATABASE_URL=postgresql://pareto:pareto_local_only@localhost:5432/pareto?schema=public
DIRECT_DATABASE_URL=
# Only needed for pnpm db:seed; use the confirmed test recruiter's Supabase UUID.
DEMO_OWNER_ID=

# Run pnpm --filter @pareto/backend storage:setup only when explicitly
# configuring the private Storage bucket in your own Supabase project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server credential alternative (do not provide both).
SUPABASE_SERVICE_ROLE_KEY=

# Gemini document embeddings use GOOGLE_GENERATIVE_AI_API_KEY (server-only).
PARETO_SEMANTIC_SEARCH=1
