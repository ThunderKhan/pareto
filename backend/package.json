{
  "name": "@pareto/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search": "./src/search/criteria.ts",
    "./search/server": "./src/search/service.ts",
    "./search/interpret": "./src/search/interpret.ts",
    "./account/server": "./src/account/service.ts",
    "./ingestion/server": "./src/ingestion/service.ts",
    "./ingestion/parse": "./src/ingestion/parse.ts",
    "./ingestion/storage": "./src/ingestion/storage.ts",
    "./ingestion/extract": "./src/ingestion/extract.ts",
    "./ingestion/queue": "./src/ingestion/queue.ts",
    "./ingestion/runner": "./src/ingestion/runner.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "storage:setup": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/setup-resume-storage.ts",
    "ingest:worker": "node --import=tsx src/ingestion/worker-runner.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "zod": "^4.1.0",
    "pino": "^10.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.16.0",
    "@supabase/supabase-js": "2.119.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "5.4.449",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "^7.0.0",
    "dotenv": "^17.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
