generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id               String           @id @default(cuid())
  ownerId          String
  displayName      String
  roleTitle        String?
  city             String?
  experienceMonths Int?
  noticePeriodDays Int?
  industry         String?
  education        String?
  employmentType   String?
  pastRoles        String[]         @default([])
  certifications   String[]         @default([])
  skillsKnown      Boolean          @default(false)
  skills           CandidateSkill[]
  createdAt        DateTime         @default(now())
  sourceDocumentId String?          @unique
  sourceDocument   ResumeDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([ownerId, roleTitle, city])
  @@index([ownerId, displayName, id])
}

model Skill {
  id          String           @id
  displayName String
  candidates  CandidateSkill[]
}

model CandidateSkill {
  candidateId String
  skillId     String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id])

  @@id([candidateId, skillId])
  @@index([skillId])
}

model SearchSession {
  id                   String           @id @default(cuid())
  ownerId              String
  referenceCandidateId String?
  latestVersion        Int              @default(0)
  createdAt            DateTime         @default(now())
  revisions            SearchRevision[]
  notifications        RecruiterNotification[]

  @@index([ownerId, createdAt])
}

model SearchRevision {
  sessionId        String
  version          Int
  requestId        String @unique
  criteria         Json
  evaluatorVersion String
  confirmedAt      DateTime @default(now())
  session          SearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, version])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

enum RecruitmentNotificationKind {
  SEARCH_CONFIRMED
  SEARCH_REFINED
}

model RecruiterSettings {
  userId          String    @id
  jobTitle        String?
  notifyConfirmed Boolean   @default(true)
  notifyRefined   Boolean   @default(true)
  updatedAt       DateTime  @updatedAt
}

model Organization {
  id          String                @id @default(cuid())
  name        String
  ownerId     String                @unique
  createdAt   DateTime              @default(now())
  members     WorkspaceMembership[]
}

model WorkspaceMembership {
  organizationId String
  userId         String
  role           WorkspaceRole @default(RECRUITER)
  joinedAt       DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model RecruiterNotification {
  id        String                        @id @default(cuid())
  userId    String
  sessionId String
  version   Int
  kind      RecruitmentNotificationKind
  title     String
  createdAt DateTime                      @default(now())
  readAt    DateTime?
  session   SearchSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId, version])
  @@index([userId, createdAt])
}

enum ResumeDocumentKind {
  PDF
  DOCX
  TXT
}

enum ResumeIngestionStatus {
  RECEIVED
  PROCESSING
  STORED
  TEXT_EXTRACTED
  READY
  NEEDS_REVIEW
  FAILED
}

/// Private resume metadata. Extracted text contains sensitive candidate data:
/// no direct Supabase Data API grants, no client-side SQL access.
model ResumeDocument {
  id              String                @id @default(cuid())
  ownerId         String
  fileName        String
  kind            ResumeDocumentKind
  mimeType        String
  byteSize        Int
  sha256          String
  storageKey      String                @unique
  status          ResumeIngestionStatus @default(RECEIVED)
  attempts        Int                   @default(1)
  extractedText   String?
  textTruncated   Boolean               @default(false)
  provider        String?
  errorCode       String?
  reviewReasons   Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  candidate       Candidate?
  evidence        ResumeEvidence[]

  @@unique([ownerId, sha256])
  @@index([ownerId, createdAt])
}

/// One evidence entry per normalized attribute / canonical skill.
model ResumeEvidence {
  id           String          @id @default(cuid())
  documentId   String
  fieldKey     String
  quote        String
  pageNumber   Int?
  sourceStart  Int?
  sourceEnd    Int?
  document     ResumeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, fieldKey])
}
