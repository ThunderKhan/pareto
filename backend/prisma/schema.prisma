generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id               String           @id @default(cuid())
  ownerId          String
  displayName      String
  roleTitle        String?
  city             String?
  experienceMonths Int?
  noticePeriodDays Int?
  industry         String?
  education        String?
  employmentType   String?
  pastRoles        String[]         @default([])
  certifications   String[]         @default([])
  skillsKnown      Boolean          @default(false)
  skills           CandidateSkill[]
  createdAt        DateTime         @default(now())

  @@index([ownerId, roleTitle, city])
  @@index([ownerId, displayName, id])
}

model Skill {
  id          String           @id
  displayName String
  candidates  CandidateSkill[]
}

model CandidateSkill {
  candidateId String
  skillId     String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id])

  @@id([candidateId, skillId])
  @@index([skillId])
}

model SearchSession {
  id                   String           @id @default(cuid())
  ownerId              String
  referenceCandidateId String?
  latestVersion        Int              @default(0)
  createdAt            DateTime         @default(now())
  revisions            SearchRevision[]

  @@index([ownerId, createdAt])
}

model SearchRevision {
  sessionId        String
  version          Int
  requestId        String @unique
  criteria         Json
  evaluatorVersion String
  confirmedAt      DateTime @default(now())
  session          SearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, version])
}
