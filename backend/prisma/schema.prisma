generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Server-only invalidation epoch for optional confirmed-search result snapshots.
// PostgreSQL triggers increment this on all candidate/evidence changes.
model CandidateSearchEpoch {
  ownerId String @id
  version BigInt @default(0)
}

model Candidate {
  id               String           @id @default(cuid())
  ownerId          String
  displayName      String
  roleTitle        String?
  city             String?
  experienceMonths Int?
  noticePeriodDays Int?
  industry         String?
  education        String?
  employmentType   String?
  pastRoles        String[]         @default([])
  certifications   String[]         @default([])
  skillsKnown      Boolean          @default(false)
  skills           CandidateSkill[]
  embedding        CandidateEmbedding?
  createdAt        DateTime         @default(now())
  sourceDocumentId String?          @unique
  sourceDocument   ResumeDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([ownerId, roleTitle, city])
  @@index([ownerId, displayName, id])
}

model Skill {
  id          String           @id
  displayName String
  candidates  CandidateSkill[]
}

model CandidateSkill {
  candidateId String
  skillId     String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id])

  @@id([candidateId, skillId])
  @@index([skillId])
}

model SearchSession {
  id                   String           @id @default(cuid())
  ownerId              String
  referenceCandidateId String?
  latestVersion        Int              @default(0)
  createdAt            DateTime         @default(now())
  revisions            SearchRevision[]
  notifications        RecruiterNotification[]

  @@index([ownerId, createdAt])
}

model SearchRevision {
  sessionId        String
  version          Int
  requestId        String @unique
  criteria         Json
  evaluatorVersion String
  confirmedAt      DateTime @default(now())
  session          SearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, version])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

enum RecruitmentNotificationKind {
  SEARCH_CONFIRMED
  SEARCH_REFINED
}

model RecruiterSettings {
  userId          String    @id
  jobTitle        String?
  notifyConfirmed Boolean   @default(true)
  notifyRefined   Boolean   @default(true)
  updatedAt       DateTime  @updatedAt
}

model Organization {
  id          String                @id @default(cuid())
  name        String
  ownerId     String                @unique
  createdAt   DateTime              @default(now())
  members     WorkspaceMembership[]
}

model WorkspaceMembership {
  organizationId String
  userId         String
  role           WorkspaceRole @default(RECRUITER)
  joinedAt       DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model RecruiterNotification {
  id        String                        @id @default(cuid())
  userId    String
  sessionId String
  version   Int
  kind      RecruitmentNotificationKind
  title     String
  createdAt DateTime                      @default(now())
  readAt    DateTime?
  session   SearchSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId, version])
  @@index([userId, createdAt])
}

enum ResumeDocumentKind {
  PDF
  DOCX
  TXT
}

enum ResumeIngestionStatus {
  RECEIVED
  PROCESSING
  STORED
  TEXT_EXTRACTED
  READY
  NEEDS_REVIEW
  FAILED
}

/// Private resume metadata. Extracted text contains sensitive candidate data:
/// no direct Supabase Data API grants, no client-side SQL access.
model ResumeDocument {
  id              String                @id @default(cuid())
  ownerId         String
  fileName        String
  kind            ResumeDocumentKind
  mimeType        String
  byteSize        Int
  sha256          String
  storageKey      String                @unique
  status          ResumeIngestionStatus @default(RECEIVED)
  attempts        Int                   @default(1)
  extractedText   String?
  textTruncated   Boolean               @default(false)
  provider        String?
  errorCode       String?
  reviewReasons   Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  candidate       Candidate?
  evidence        ResumeEvidence[]
  ingestionJob    IngestionJob?
  reviewState     ResumeReviewState @default(UNREVIEWED)
  reviewVersion   Int               @default(0)
  reviewedAt      DateTime?
  reviewedBy      String?
  audit           ResumeProfileAudit[]

  @@unique([ownerId, sha256])
  @@index([ownerId, createdAt])
}

/// One evidence entry per normalized attribute / canonical skill.
model ResumeEvidence {
  id           String          @id @default(cuid())
  documentId   String
  fieldKey     String
  quote        String
  pageNumber   Int?
  sourceStart  Int?
  sourceEnd    Int?
  document     ResumeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, fieldKey])
}

enum IngestionJobStatus {
  QUEUED
  RUNNING
  RETRY_SCHEDULED
  READY
  NEEDS_REVIEW
  FAILED_PERMANENT
  CANCELLED
}

enum IngestionJobStage {
  QUEUED
  PARSING
  EXTRACTING
  PERSISTING
  COMPLETE
}

/// Durable, owner-bound, at-least-once work. No model writes without a valid
/// lease/fencing token. Exactly one logical job for each source document.
model IngestionJob {
  id               String             @id @default(uuid())
  ownerId          String
  documentId       String             @unique
  document         ResumeDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            IngestionBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  status           IngestionJobStatus @default(QUEUED)
  stage            IngestionJobStage  @default(QUEUED)
  priority         Int                @default(0)
  attempts         Int                @default(0)
  maxAttempts      Int                @default(3)
  manualRetries    Int                @default(0)
  generation       Int                @default(0)
  runAfter         DateTime           @default(now())
  workerId         String?
  leaseToken       String?            @unique
  leaseExpiresAt   DateTime?
  heartbeatAt      DateTime?
  cancelRequested  Boolean            @default(false)
  lastErrorCode    String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  history          IngestionAttempt[]

  @@index([ownerId, createdAt])
  @@index([batchId, createdAt])
  @@index([status, runAfter, priority])
  @@index([status, leaseExpiresAt])
}

model IngestionBatch {
  id          String         @id @default(uuid())
  ownerId     String
  label       String?
  createdAt   DateTime       @default(now())
  jobs        IngestionJob[]

  @@index([ownerId, createdAt])
}

enum IngestionAttemptOutcome {
  RUNNING
  RETRY
  READY
  NEEDS_REVIEW
  FAILED
  CANCELLED
  RECOVERED
}

model IngestionAttempt {
  id            String                  @id @default(uuid())
  jobId         String
  job           IngestionJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt       Int
  generation    Int                     @default(0)
  leaseToken    String
  workerId      String
  outcome       IngestionAttemptOutcome @default(RUNNING)
  errorCode     String?
  startedAt     DateTime                @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  parseMs       Int?
  modelMs       Int?
  persistMs     Int?
  sourceChars   Int?
  evidenceCount Int?
  verifiedFields Int?
  provider      String?
  extractorVersion String?

  @@unique([jobId, generation, attempt])
  @@index([jobId, startedAt])
  @@index([jobId, finishedAt])
}

enum ResumeReviewState {
  UNREVIEWED
  NEEDS_REVIEW
  HUMAN_VERIFIED
}

enum ResumeAuditAction {
  MODEL_EXTRACTED
  REVIEW_REQUIRED
  HUMAN_CORRECTED
  HUMAN_APPROVED
  HUMAN_REJECTED
}

/// Immutable, private field-level extraction / human-correction audit.
/// JSON may contain candidate PII; these records are never publicly exposed.
/// Application services must owner-filter every query and never log snapshots.
model ResumeProfileAudit {
  id             String            @id @default(uuid())
  documentId     String
  document       ResumeDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ownerId        String
  actorId        String?
  action         ResumeAuditAction
  reviewVersion  Int
  changedFields  String[]          @default([])
  before         Json?
  after          Json?
  reason         String?
  provider       String?
  extractorVersion String?
  jobId          String?
  attempt        Int?
  createdAt      DateTime          @default(now())

  @@index([ownerId, createdAt])
  @@index([documentId, createdAt])
}

/// Hourly AI attempt reservations shared by all application replicas.
model AiRequestQuota {
  scope       String
  subject     String
  windowStart DateTime @db.Timestamp(3)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamp(3)

  @@id([scope, subject, windowStart])
}

/// Private recruiter-scoped pgvector cache; not authoritative for eligibility.
model CandidateEmbedding {
  candidateId    String @id
  ownerId        String
  model          String
  contentHash    String
  contentVersion Int @default(1)
  embedding      Unsupported("vector(768)")
  updatedAt      DateTime @default(now()) @updatedAt
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([ownerId, model])
}
